# Зависимости
node_modules/

# Сборка веб-части (React/Vite)
dist/
dist-ssr/

# Сборка десктопной части (Rust/Tauri) — самая тяжёлая папка, в git не нужна
src-tauri/target/

# Иконки, сгенерированные командой `npm run tauri icon` — храни только исходную
# картинку 1024x1024, из которой они генерируются, а не сами сгенерированные файлы,
# если не хочешь, чтобы CI их пересобирал заново (см. .github/workflows/release.yml)

# Логи и служебные файлы редакторов/ОС
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Локальные переменные окружения (если появятся ключи/секреты)
.env
.env.local
